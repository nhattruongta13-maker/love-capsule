      "targets": [{"expr": "sum by (route, method) (rate(lovecapsule_http_requests_total[5m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "5xx Responses",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
