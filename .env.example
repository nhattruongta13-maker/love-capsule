# Copy to .env locally, then replace the placeholder with a strong secret.
# Never commit the real .env file.
JWT_SIGNING_KEY=replace-with-a-long-random-production-secret
AUTH_RATE_LIMIT_PERMIT_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_SEGMENTS=2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-dashboard-password
